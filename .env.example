# --- Postgres ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant_db

# --- Backend app ---
APP_NAME=Personal Assistant Platform
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_REGISTRATION_CODE=replace-with-a-secret-admin-code
CORS_ORIGINS=["http://localhost:5173"]

# These two are also composed automatically inside docker-compose.yml from
# the Postgres vars above; override here only for non-docker/local runs.
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant_db
CHECKPOINTER_DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant_db

# --- LLM provider (Google Gemini via LangChain) ---
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004

# --- Frontend (build-time) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
